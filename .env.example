# Google Cloud & Vertex AI Agent Platform Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# Optional Google Gemini API Key (if running outside Vertex AI)
GEMINI_API_KEY=your_gemini_api_key_here

# Strava V3 OAuth 2.0 Credentials
# In production (Agent Runtime / Cloud Run), these are resolved exclusively from
# Google Cloud Secret Manager via SecretManagerClient.
STRAVA_CLIENT_ID=your_strava_client_id_integer
STRAVA_CLIENT_SECRET=your_strava_client_secret_placeholder
STRAVA_ACCESS_TOKEN=your_strava_short_lived_access_token_placeholder
STRAVA_REFRESH_TOKEN=your_strava_refresh_token_placeholder

# Proactive Notification Webhook (Optional)
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
AGENT_DB_PATH=strava_health_memory.db
